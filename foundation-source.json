  {
    "number": 6,
    "title": "Workspace: UV Editing",
    "texts": [
      "Workspace: UV Editing",
      "Workspaces",
      "Usage",
      "Used for unwrapping your 3D model like a cardboard box. This lets you flatten a 3D object into a 2D map so that flat image textures can wrap around it perfectly without stretching."
    ],
    "media": [
      "ppt/media/image6.gif"
    ]
  },
  {
    "number": 7,
    "title": "Workspace: Texture Painting",
    "texts": [
      "Workspace: Texture Painting",
      "Workspaces",
      "Usage",
      "Allows you to paint directly onto your 3D models. It gives you brushes to draw colors, patterns, and details straight onto your object's surfaces."
    ],
    "media": [
      "ppt/media/image7.gif"
    ]
  },
  {
    "number": 8,
    "title": "Workspace: Shading",
    "texts": [
      "Workspace: Shading",
      "Workspaces",
      "Usage",
      "The place where you give objects their material properties. It provides a visual grid (Shader Editor) where you link color, glossiness, and texture blocks together using a system called \"nodes\"."
    ],
    "media": [
      "ppt/media/image8.gif"
    ]
  },
  {
    "number": 9,
    "title": "Workspace: Animation",
    "texts": [
      "Workspace: Animation",
      "Workspaces",
      "Usage",
      "Setup to make objects move over time. It splits your view so you can see your 3D scene alongside a timeline and a \"Dope Sheet\" to track your animation keyframes."
    ],
    "media": [
      "ppt/media/image9.gif"
    ]
  },
  {
    "number": 10,
    "title": "Workspace: Rendering",
    "texts": [
      "Workspace: Rendering",
      "Workspaces",
      "Usage",
      "A dedicated screen to view and review your finished images. When you hit render, your final high-quality picture or movie clip appears here for inspection."
    ],
    "media": [
      "ppt/media/image10.gif"
    ]
  },
  {
    "number": 11,
    "title": "Workspace: Compositing",
    "texts": [
      "Workspace: Compositing",
      "Workspaces",
      "Usage",
      "Used for post-processing and photo editing. After rendering, you use this node-based layout to tweak colors, add blur, create lens flares, or mix multiple images together before final export."
    ],
    "media": [
      "ppt/media/image11.gif"
    ]
  },
  {
    "number": 12,
    "title": "Workspace: Geometry Nodes",
    "texts": [
      "Workspace: Geometry Nodes",
      "Workspaces",
      "Usage",
      "A modern space used to build objects procedurally with code-like blocks. Instead of modeling by hand, you connect nodes to generate landscapes, scatter instances (like grass on a hill), or build automated structures."
    ],
    "media": [
      "ppt/media/image12.png"
    ]
  },
